# PostgreSQL local (lo levanta ./db.sh up). DATABASE_URL tiene que usar los mismos datos.
POSTGRES_USER=lejuy
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=lejuy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lejuy:cambiame@127.0.0.1:5432/lejuy
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
# Lista JSON con las URLs del front (agregar la de Vercel en producción)
CORS_ORIGINS=["http://localhost:3000"]
